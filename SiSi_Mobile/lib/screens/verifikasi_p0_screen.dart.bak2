import 'dart:async';
import 'package:flutter/material.dart';
import '../db/repositories/p0_repository.dart';
import '../services/api_service.dart';
import '../services/p0_job_type_change.dart';
import '../services/p0_sync_action.dart';
import '../widgets/p0_auto_save_job_type_picker.dart';
import '../widgets/p0_sync_button.dart';

class VerifikasiP0Screen extends StatefulWidget {
  final Map<String, dynamic> sesi;
  const VerifikasiP0Screen({super.key, required this.sesi});
  @override State<VerifikasiP0Screen> createState() => _P0State();
}
class _P0State extends State<VerifikasiP0Screen> {
  final repo = P0Repository();
  late final P0SyncAction p0Sync = P0SyncAction(repo);
  static const ink = Color(0xFF18334D), blue = Color(0xFF225FC2), muted = Color(0xFF52687C);
  DateTime date = DateTime.now();
  String status = 'Menunggu', search = '', error = '';
  bool loaded = false, loading = false, offline = false, saving = false;
  int request = 0, queued = 0;
  List<Map<String, dynamic>> items = [];
  Map<String, dynamic> counts = {};
  StreamSubscription<int>? subscription;
  String? editCode;
  String? selectedType;
  Map<String, dynamic> master = {};
  bool masterLoading = false;
  String editError = '';
  final expanded = <String>{};
  final attachments = <String, Map<String, dynamic>>{};
  final attachmentBusy = <String>{};
  String get day => '${date.year}-${date.month.toString().padLeft(2, '0')}-${date.day.toString().padLeft(2, '0')}';
  String get ulp => (widget.sesi['ulp'] ?? '').toString();
  bool get admin => P0Repository.admin(widget.sesi);
  String text(Map<String, dynamic> x, String key) => (x[key] ?? '').toString();
  String label(String s) => {'Approved':'Disetujui','Rejected':'Ditolak'}[s] ?? s;
  String dateText(dynamic value) { final d = DateTime.tryParse('$value'); return d == null ? '$value' : '${d.day.toString().padLeft(2,'0')}/${d.month.toString().padLeft(2,'0')}/${d.year}'; }
  @override void initState() { super.initState(); subscription = repo.pantauJumlahAntrean().listen((n) { if (mounted) setState(() => queued = n); }); }
  @override void dispose() { subscription?.cancel(); super.dispose(); }
  void message(String s) { if (mounted) ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(s))); }
  Future<void> fetch({bool local = false}) async {
    final id = ++request;
    setState(() { loading = true; loaded = true; error = ''; editCode = null; });
    try {
      final r = local ? await repo.bacaListLokal(ulp: ulp, status: status, tanggal: day) : await repo.bacaList(ulp: ulp, status: status, tanggal: day);
      if (!mounted || id != request) return;
      setState(() {
        items = (r['list'] as List? ?? []).map((x) => Map<String,dynamic>.from(x as Map)).toList();
        counts = Map<String,dynamic>.from(r['counts'] ?? {});
        if (!local) offline = r['offline'] == true;
        if (r['ok'] != true) error = '${r['message'] ?? r['error'] ?? 'Gagal memuat P0.'}';
      });
    } catch (e) { if (mounted && id == request) setState(() => error = e.toString()); }
    finally { if (mounted && id == request) setState(() => loading = false); }
  }
  Future<void> pickDate() async {
    final d = await showDatePicker(context: context, initialDate: date, firstDate: DateTime(2025), lastDate: DateTime.now().add(const Duration(days:1)));
    if (d == null || !mounted) return;
    setState(() => date = d); if (loaded) await fetch();
  }
  Widget badge(String s) => Container(padding: const EdgeInsets.symmetric(horizontal:9,vertical:5), decoration: BoxDecoration(color: s == 'Menunggu' ? const Color(0xFFF9E38C) : s == 'Approved' ? const Color(0xFFDDF0E5) : const Color(0xFFFBE4E3), borderRadius: BorderRadius.circular(7)), child: Text(label(s), style: const TextStyle(fontSize:11,fontWeight:FontWeight.w700,color:ink)));
  Widget notice(String s) => Container(width: double.infinity, margin: const EdgeInsets.only(bottom:12), padding: const EdgeInsets.all(12), decoration: BoxDecoration(color: const Color(0xFFFFF5D5),borderRadius: BorderRadius.circular(12)), child: Text(s,style: const TextStyle(fontSize:12,color:Color(0xFF795211))));
  String photoUrl(dynamic value) => value is Map ? (value['thumb'] ?? '').toString() : '';
  Widget photo(String title, dynamic value) {
    final url = photoUrl(value);
    return Expanded(child: Semantics(label:'Foto $title, ketuk untuk perbesar',button:url.isNotEmpty, child: InkWell(onTap:url.isEmpty?null:()=>showPhoto(title,url),borderRadius:BorderRadius.circular(10),child:Column(children:[
      AspectRatio(aspectRatio:1.05,child:ClipRRect(borderRadius:BorderRadius.circular(10),child:url.isEmpty?const ColoredBox(color:Color(0xFFDCE5EB),child:Center(child:Icon(Icons.image_not_supported_outlined,color:muted))):Image.network(url,fit:BoxFit.cover,loadingBuilder:(c,w,p)=>p==null?w:const ColoredBox(color:Color(0xFFDCE5EB),child:Center(child:CircularProgressIndicator(strokeWidth:2))),errorBuilder:(c,e,s)=>const ColoredBox(color:Color(0xFFDCE5EB),child:Center(child:Icon(Icons.broken_image_outlined,color:muted)))))),
      Padding(padding:const EdgeInsets.symmetric(vertical:8),child:Row(mainAxisAlignment:MainAxisAlignment.spaceBetween,children:[Flexible(child:Text(title,style:const TextStyle(fontSize:11))),const Icon(Icons.open_in_full,size:12,color:blue)])),
    ]))));
  }
  Future<void> showPhoto(String title,String url) async {
    final transform = TransformationController();
    int attempt = 0;
    await showDialog<void>(context:context,builder:(ctx)=>StatefulBuilder(builder:(ctx,setModal)=>Dialog.fullscreen(backgroundColor:ink,child:SafeArea(child:Column(children:[
      Row(children:[Expanded(child:Padding(padding:const EdgeInsets.all(16),child:Text(title,style:const TextStyle(color:Color(0xFFF7FAFC),fontSize:18,fontWeight:FontWeight.w700)))),IconButton(tooltip:'Tutup foto',onPressed:()=>Navigator.pop(ctx),icon:const Icon(Icons.close,color:Color(0xFFF7FAFC)))]),
      Expanded(child:InteractiveViewer(transformationController:transform,maxScale:5,child:Center(child:Image.network(url.replaceAll('sz=w400','sz=w1600'),key:ValueKey(attempt),fit:BoxFit.contain,loadingBuilder:(c,w,p)=>p==null?w:const Center(child:CircularProgressIndicator()),errorBuilder:(c,e,s)=>Column(mainAxisSize:MainAxisSize.min,children:[const Text('Foto gagal dimuat. Periksa koneksi.',style:TextStyle(color:Color(0xFFF7FAFC))),TextButton(onPressed:()async{await NetworkImage(url.replaceAll('sz=w400','sz=w1600')).evict();if(ctx.mounted)setModal(()=>attempt++);},child:const Text('Coba lagi'))]))))),
      Row(mainAxisAlignment:MainAxisAlignment.center,children:[IconButton(tooltip:'Perkecil',onPressed:(){final s=(transform.value.getMaxScaleOnAxis()/1.5).clamp(1.0,5.0);transform.value=Matrix4.identity()..scale(s);},icon:const Icon(Icons.remove,color:Color(0xFFF7FAFC))),TextButton(onPressed:()=>transform.value=Matrix4.identity(),child:const Text('Reset zoom')),IconButton(tooltip:'Perbesar',onPressed:(){final s=(transform.value.getMaxScaleOnAxis()*1.5).clamp(1.0,5.0);transform.value=Matrix4.identity()..scale(s);},icon:const Icon(Icons.add,color:Color(0xFFF7FAFC)))]),
      const Padding(padding:EdgeInsets.all(12),child:Text('Cubit dan geser untuk memeriksa foto serta watermark.',style:TextStyle(color:Color(0xFFD7E6EF),fontSize:12))),
    ])))));
    transform.dispose();
  }
  Future<void> beginEdit(Map<String,dynamic> x) async {
    if (!admin || saving) return;
    if (x['koreksiPending']==true) { message('Koreksi sebelumnya belum terkirim. Buka Pengaturan untuk mengirimnya.'); return; }
    final code=text(x,'kodeP0');
    setState(() { editCode=code;masterLoading=true;editError='';selectedType=null;weight.text=text(x,'bobotManual'); });
    try {
      final r=await repo.masterJenis();
      if(!mounted||editCode!=code)return;
      final list=(r['list'] as List? ?? []).map((e)=>e.toString()).toSet().toList();
      setState((){master=r;selectedType=list.contains(text(x,'namaPekerjaan'))?text(x,'namaPekerjaan'):null;});
      if(list.isEmpty)setState(()=>editError='Master jenis pekerjaan kosong.');
    } catch(e){if(mounted&&editCode==code)setState(()=>editError=e.toString());}
    finally{if(mounted&&editCode==code)setState(()=>masterLoading=false);}
  }
  Widget editor(Map<String,dynamic>x){
    if(editCode!=text(x,'kodeP0'))return const SizedBox.shrink();
    final list=(master['list'] as List? ?? []).map((e)=>e.toString()).toSet().toList();
    return Padding(padding:const EdgeInsets.symmetric(vertical:16),child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
      const Divider(),const Text('Koreksi jenis pekerjaan',style:TextStyle(fontSize:18,fontWeight:FontWeight.w700)),const SizedBox(height:8),
      const Text('Foto, tanggal, petugas, dan kode P0 tidak berubah. Poin dihitung ulang oleh server setelah koreksi dikirim.',style:TextStyle(fontSize:13,color:muted)),const SizedBox(height:16),
      if(masterLoading)const LinearProgressIndicator() else ...[
        if(master['offline']==true)notice('Menggunakan master tersimpan. Pilihan divalidasi ulang saat pengiriman.'),
        P0AutoSaveJobTypePicker(
          item: x,
          options: list,
          repository: P0JobTypeChange(repo),
          initialValue: selectedType,
          onSaved: () async {
            attachments.remove(text(x, 'kodeP0'));
            await fetch(local: true);
            message('Jenis pekerjaan tersimpan di HP. Tekan Sinkron sekarang untuk mengirim.');
          },
        ),
        const SizedBox(height:16),
        Text('Bobot pekerjaan: ${((master['bobotByNama'] as Map?)?[selectedType?.toLowerCase()]) ?? 'mengikuti master'}',style:const TextStyle(fontSize:13,color:muted)),
        const Padding(padding:EdgeInsets.symmetric(vertical:12),child:Text('Skor waktu tetap otomatis. Poin = skor waktu + (bobot pekerjaan × pengali lama).',style:TextStyle(fontSize:13,color:muted))),
      ],
      if(editError.isNotEmpty)Text(editError,style:const TextStyle(color:Color(0xFFBA3030))),
      const SizedBox(height:12),TextButton(onPressed:saving?null:()=>setState(()=>editCode=null),child:const Text('Tutup')),
    ]));
  }
  Future<void> decide(Map<String,dynamic>x,String decision)async{
    if(!admin||saving)return;
    final ctrl=TextEditingController();
    final form=GlobalKey<FormState>();
    final yes=await showDialog<bool>(context:context,builder:(ctx)=>AlertDialog(title:Text(decision=='Approved'?'Setujui P0 ini?':'Alasan penolakan'),content:Form(key:form,child:Column(mainAxisSize:MainAxisSize.min,children:[const Text('Keputusan disimpan di HP. Kirim lewat Sinkron sekarang; koreksi jenis dikirim lebih dahulu.'),if(decision=='Rejected')TextFormField(controller:ctrl,maxLines:3,decoration:const InputDecoration(labelText:'Alasan wajib diisi'),validator:(s)=>s==null||s.trim().isEmpty?'Isi alasan penolakan.':null)])),actions:[TextButton(onPressed:()=>Navigator.pop(ctx,false),child:const Text('Batal')),FilledButton(onPressed:(){if(form.currentState!.validate())Navigator.pop(ctx,true);},child:const Text('Simpan keputusan'))]));
    final why=ctrl.text;ctrl.dispose();if(yes!=true||!mounted)return;
    setState(()=>saving=true);
    try{final r=await repo.catatKeputusan(kodeP0:text(x,'kodeP0'),keputusan:decision,username:(widget.sesi['username']??'').toString(),alasan:why,tanggal:day);if(r['ok']!=true)throw StateError('${r['message']}');await fetch(local:true);message('Keputusan tersimpan lokal, belum terkirim.');}catch(e){message(e.toString());}finally{if(mounted)setState(()=>saving=false);}
  }
  Future<void> undo(String code)async{if(saving)return;setState(()=>saving=true);try{final r=await repo.batalkanKeputusan(code);if(r['ok']!=true)throw StateError('${r['message']}');await fetch(local:true);}catch(e){message(e.toString());}finally{if(mounted)setState(()=>saving=false);}}
  Future<void> loadAttachment(String code)async{
    if(attachmentBusy.contains(code))return;setState(()=>attachmentBusy.add(code));
    try{final r=await ApiService.getLampiranPengecekanP0(code);if(mounted)setState(()=>attachments[code]=r);}catch(e){if(mounted)setState(()=>attachments[code]={'ok':false,'error':e.toString()});}finally{if(mounted)setState(()=>attachmentBusy.remove(code));}
  }
  Widget facts(Map<String,dynamic>x,Map<String,String> fields)=>Column(children:fields.entries.map((f)=>Padding(padding:const EdgeInsets.symmetric(vertical:5),child:Row(crossAxisAlignment:CrossAxisAlignment.start,children:[Expanded(child:Text(f.value,style:const TextStyle(fontSize:12,color:muted))),const SizedBox(width:16),Expanded(child:Text(text(x,f.key).isEmpty?'Belum tersedia':text(x,f.key),style:const TextStyle(fontSize:13,fontWeight:FontWeight.w600),textAlign:TextAlign.right))]))).toList());
  Widget attachmentView(String code){
    final r=attachments[code];
    if(attachmentBusy.contains(code))return const Padding(padding:EdgeInsets.all(16),child:LinearProgressIndicator());
    if(r==null)return TextButton.icon(onPressed:()=>loadAttachment(code),icon:const Icon(Icons.attach_file),label:const Text('Muat lampiran Switching / Gardu'));
    if(r['ok']!=true)return Column(children:[Text('${r['error']??r['message']??'Lampiran gagal dimuat.'}',style:const TextStyle(fontSize:12,color:muted)),TextButton(onPressed:()=>loadAttachment(code),child:const Text('Coba lagi'))]);
    final switches=r['switching'] as List? ?? [], gardu=r['gardu'] as List? ?? [];
    return Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
      if(switches.isEmpty&&gardu.isEmpty)const Text('Tidak ada lampiran pengecekan untuk pekerjaan ini.',style:TextStyle(fontSize:13,color:muted)),
      for(final raw in switches)ExpansionTile(tilePadding:EdgeInsets.zero,title:Text('${raw['namaSwitching']??'Switching'}',style:const TextStyle(fontSize:14)),children:[facts(Map<String,dynamic>.from(raw),{'penyulang':'Penyulang','jamPengecekan':'Jam','arusR':'Arus R (A)','arusS':'Arus S (A)','arusT':'Arus T (A)','indikatorRemote':'Remote','indikatorLocal':'Local','indicatorProtection':'Protection','indicatorReclose':'Reclose'}),Row(children:[photo('Arus',raw['fotoArus']),const SizedBox(width:8),photo('Gangguan 1',raw['fotoG1']),const SizedBox(width:8),photo('Gangguan 2',raw['fotoG2'])]),Row(children:[photo('Gangguan 3',raw['fotoG3']),const SizedBox(width:8),photo('Gangguan 4',raw['fotoG4']),const SizedBox(width:8),photo('Gangguan 5',raw['fotoG5'])])]),
      for(final raw in gardu)ExpansionTile(tilePadding:EdgeInsets.zero,title:Text('Gardu ${raw['noGardu']??''}',style:const TextStyle(fontSize:14)),children:[facts(Map<String,dynamic>.from(raw),{'alamat':'Alamat','penyulang':'Penyulang','section':'Section','petugas':'Petugas','jamUkur':'Jam ukur','bebanR':'Beban R (A)','bebanS':'Beban S (A)','bebanT':'Beban T (A)','bebanN':'Beban N (A)','tegRS':'Tegangan R-S (V)','tegRT':'Tegangan R-T (V)','tegST':'Tegangan S-T (V)','tegRN':'Tegangan R-N (V)','tegSN':'Tegangan S-N (V)','tegTN':'Tegangan T-N (V)'})]),
    ]);
  }
  Widget card(Map<String,dynamic>x,int index){
    final code=text(x,'kodeP0'),st=text(x,'status');final cyan=index.isOdd;
    return Container(margin:const EdgeInsets.only(bottom:20),clipBehavior:Clip.antiAlias,decoration:BoxDecoration(color:cyan?const Color(0xFFEDF9FA):const Color(0xFFF0F6FE),borderRadius:BorderRadius.circular(20),border:Border.all(color:cyan?const Color(0xFFA9D9E0):const Color(0xFFB7D0EF))),child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
      Container(width:double.infinity,padding:const EdgeInsets.all(18),color:cyan?const Color(0xFFDDF2F5):const Color(0xFFE2EEFC),child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[Row(children:[Expanded(child:Text(code,style:const TextStyle(fontSize:11,fontWeight:FontWeight.w700,color:blue))),const SizedBox(width:8),badge(st)]),const SizedBox(height:12),Text(text(x,'namaPekerjaan'),style:const TextStyle(fontSize:20,fontWeight:FontWeight.w700,color:ink,height:1.3)),if(admin)TextButton.icon(onPressed:saving?null:()=>beginEdit(x),icon:const Icon(Icons.edit_outlined,size:16),label:const Text('Edit jenis',style:TextStyle(fontSize:12))),Text('${text(x,'penyulang')} / ${text(x,'section')} · ${dateText(x['tanggal'])}',style:const TextStyle(fontSize:12,color:muted))])),
      Padding(padding:const EdgeInsets.fromLTRB(16,16,16,0),child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
        Text('${text(x,'tim')} · ${text(x,'durasi')}\n${text(x,'petugas')}',style:const TextStyle(fontSize:13,color:muted)),const SizedBox(height:16),
        Row(children:[photo('Sebelum',x['fotoSebelum']),const SizedBox(width:8),photo('Pekerjaan',x['fotoPekerjaan']),const SizedBox(width:8),photo('Sesudah',x['fotoSesudah'])]),
        const Text('Ketuk foto untuk memperbesar dan melihat watermark.',style:TextStyle(fontSize:11,color:muted)),const SizedBox(height:12),
        if(x['koreksiPending']==true)notice('Koreksi jenis belum terkirim. ${text(x,'koreksiGagal')}'),
        if(x['lokalPending']==true)notice('Keputusan tersimpan di HP, belum terkirim. ${text(x,'lokalGagal')}'),
        if(x['koreksiServerPending']==true)notice('Server belum menuntaskan koreksi. Kirim ulang koreksi dari perangkat asal.'),
        editor(x),
        if(expanded.contains(code)) ...[
          const Divider(),facts(x,{'daerah':'Daerah','jarakAntarP0':'Jarak antar P0','jarakClosing':'Jarak closing','koordinat':'Koordinat','koordinatClosing':'Koordinat closing','catatan':'Catatan','bobotManual':'Bobot manual','point':'Poin','approvedBy':'Diputuskan oleh','timestampApprove':'Tanggal keputusan','alasanRejected':'Alasan penolakan'}),
          if(x['koreksiPending']==true)Text('Alasan koreksi lokal: ${text(x,'alasanKoreksiLokal')}',style:const TextStyle(fontSize:13)),
          for(final h in x['koreksiHistory'] as List? ?? [])Padding(padding:const EdgeInsets.symmetric(vertical:8),child:Text('${h['namaLama']} → ${h['namaPekerjaan']}\n${h['username']} · ${h['at']}\nBobot: ${h['bobotManual']??'master'} · ${h['alasan']}',style:const TextStyle(fontSize:12,color:muted))),
          const SizedBox(height:12),attachmentView(code),const SizedBox(height:16),
        ],
      ])),
      Padding(padding:const EdgeInsets.fromLTRB(12,4,12,12),child:Wrap(spacing:8,runSpacing:8,alignment:WrapAlignment.spaceBetween,children:[TextButton(onPressed:saving?null:()=>setState((){expanded.contains(code)?expanded.remove(code):expanded.add(code);}),child:Text(expanded.contains(code)?'Tutup detail':'Detail pekerjaan',style:const TextStyle(fontSize:12))),if(admin&&st=='Menunggu') ...[OutlinedButton(onPressed:saving?null:()=>decide(x,'Rejected'),child:const Text('Tolak')),FilledButton(onPressed:saving?null:()=>decide(x,'Approved'),child:const Text('Setujui'))] else if(admin&&x['lokalPending']==true)OutlinedButton(onPressed:saving?null:()=>undo(code),child:const Text('Batalkan keputusan'))])),
    ]));
  }
  @override Widget build(BuildContext context){
    final filtered=items.where((x)=>'${text(x,'namaPekerjaan')} ${text(x,'penyulang')} ${text(x,'kodeP0')}'.toLowerCase().contains(search.toLowerCase())).toList();
    return PopScope(canPop:!saving,child:Theme(data:Theme.of(context).copyWith(colorScheme:Theme.of(context).colorScheme.copyWith(primary:blue)),child:Scaffold(backgroundColor:const Color(0xFFF5F8FC),appBar:AppBar(title:const Text('Verifikasi P0'),actions:[IconButton(tooltip:'Muat ulang',onPressed:saving||loading?null:()=>fetch(),icon:const Icon(Icons.refresh))]),body:Center(child:ConstrainedBox(constraints:const BoxConstraints(maxWidth:760),child:Column(children:[
      Padding(padding:const EdgeInsets.fromLTRB(16,12,16,0),child:Column(children:[
        if(queued>0)
          P0SyncButton(
            pending: queued,
            action: p0Sync,
            onComplete: (result) async {
              await fetch(local: true);
              if (mounted && result['ok'] != true) {
                message(P0SyncAction.message(result));
              }
            },
          ),if(offline)notice('Mode offline: menggunakan data tersimpan. Foto yang belum tersimpan membutuhkan koneksi.'),
        Row(children:[Expanded(child:OutlinedButton.icon(onPressed:saving||loading?null:pickDate,icon:const Icon(Icons.calendar_today_outlined,size:16),label:Text(dateText(day)))),const SizedBox(width:8),FilledButton(onPressed:saving||loading?null:()=>fetch(),child:const Text('Cari P0'))]),
        const SizedBox(height:8),Row(children:['Menunggu','Approved','Rejected'].map((s)=>Expanded(child:TextButton(onPressed:saving||loading?null:(){setState(()=>status=s);if(loaded)fetch(local:true);},style:TextButton.styleFrom(backgroundColor:s==status?const Color(0xFFE2EEFC):null),child:Text('${label(s)} ${counts[s]??''}',style:TextStyle(fontSize:11,fontWeight:s==status?FontWeight.w700:FontWeight.w400))))).toList()),
        const SizedBox(height:8),TextField(enabled:!saving,onChanged:(s)=>setState(()=>search=s),decoration:const InputDecoration(hintText:'Cari pekerjaan atau penyulang',prefixIcon:Icon(Icons.search),isDense:true,border:OutlineInputBorder())),const SizedBox(height:12),
      ])),
      Expanded(child:loading?const Center(child:CircularProgressIndicator()):error.isNotEmpty?Center(child:Padding(padding:const EdgeInsets.all(24),child:Column(mainAxisSize:MainAxisSize.min,children:[Text(error),TextButton(onPressed:()=>fetch(),child:const Text('Coba lagi'))]))):!loaded?const Center(child:Padding(padding:EdgeInsets.all(24),child:Text('Pilih tanggal lalu tekan Cari P0.\nKeputusan dan koreksi disimpan di HP sebelum dikirim.',textAlign:TextAlign.center,style:TextStyle(color:muted)))):RefreshIndicator(onRefresh:()=>fetch(),child:ListView.builder(physics:const AlwaysScrollableScrollPhysics(),padding:const EdgeInsets.all(16),itemCount:filtered.isEmpty?1:filtered.length,itemBuilder:(c,i)=>filtered.isEmpty?const Padding(padding:EdgeInsets.all(24),child:Text('Tidak ada pekerjaan sesuai tanggal, status, atau pencarian.',textAlign:TextAlign.center)):card(filtered[i],i)))),
    ]))))));
  }
}
