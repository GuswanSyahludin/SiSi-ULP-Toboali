name: Finalize Jadwal WA Report
on:
  push:
    branches: [fix/jadwal-padam-wa-report-final]
permissions:
  contents: write
jobs:
  finalize:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: fix/jadwal-padam-wa-report-final
      - run: python .github/scripts/finalize_jadwal_wa_report.py
      - run: |
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add SiSi_BackEnd/Teknik/Jadwal-Padam.html
          git commit -m "fix(web): finalize combined WA report controls [skip ci]" || exit 0
          git push origin fix/jadwal-padam-wa-report-final
