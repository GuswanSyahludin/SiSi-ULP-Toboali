name: Patch trigger audit log
on:
  push:
    branches: [main]
    paths: [scripts/patch_trigger_audit_log.py]
permissions:
  contents: write
jobs:
  patch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with: {ref: main}
      - run: python scripts/patch_trigger_audit_log.py
      - run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add SiSi_BackEnd/Core/Trigger-Manager.js
          git commit -m "fix(backend): log hasil auditTriggerSiSi"
          git push origin HEAD:main
