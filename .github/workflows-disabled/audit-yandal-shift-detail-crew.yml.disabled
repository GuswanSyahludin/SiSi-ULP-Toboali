name: Audit Yandal Shift Detail Crew
on:
  push:
    branches: [fix/yandal-shift-detail-crew]
  workflow_dispatch:
permissions:
  contents: write
jobs:
  patch-analyze-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: fix/yandal-shift-detail-crew
      - run: python .github/scripts/patch_yandal_shift_detail_crew.py
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
      - working-directory: SiSi_Mobile
        run: flutter pub get
      - working-directory: SiSi_Mobile
        run: flutter analyze --no-fatal-infos --no-fatal-warnings
      - working-directory: SiSi_Mobile
        run: flutter build apk --debug
      - name: Commit audited fix
        run: |
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add SiSi_BackEnd/Core/Delta-Sync-Mobile.js SiSi_Mobile/lib/screens/yandal_screen.dart
          git commit -m "fix(yandal): show shift header and crew data [skip ci]" || exit 0
          git push origin fix/yandal-shift-detail-crew
